# Proposed configuration names; O00/O01 must generate and validate exact schemas.
# No secrets are included. Server-only names never get NEXT_PUBLIC_ prefixes.
PAIRBAND_MODE=preview
NEXT_PUBLIC_PAIRBAND_MODE=preview
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_RPC_SECONDARY_URL=
DEPLOYMENT_MANIFEST_PATH=./deployments/arc-testnet.json
DATABASE_URL=
SESSION_SECRET=
PUBLIC_SITE_ORIGIN=http://localhost:3000
PUBLIC_APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
GRAPH_ENABLED=false
GRAPH_ENDPOINT=
GRAPH_API_KEY=
CIRCLE_FUNDING_ENABLED=false
CIRCLE_API_KEY=
UNISWAP_TRADING_API_ENABLED=false
UNISWAP_API_KEY=
ERROR_REPORTING_DSN=
LOG_LEVEL=info
# Use keystore/hardware/managed signer profiles for later authorized deployment.
# Do not add a plaintext production private key to this file.

# Broadcast gate (O10): only set to 1 when operator explicitly authorizes Arc testnet deploys.
PAIRBAND_ALLOW_BROADCAST=0
