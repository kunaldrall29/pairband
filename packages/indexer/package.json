{
  "name": "@pairband/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@pairband/database": "workspace:*",
    "@pairband/domain": "workspace:*",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
