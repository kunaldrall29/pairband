{
  "name": "@pairband/contracts",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "forge build --via-ir",
    "test": "forge test --via-ir -vv",
    "test:gas": "forge test --via-ir --gas-report",
    "fmt": "forge fmt",
    "deploy:anvil": "forge script script/Deploy.s.sol:DeployScript --rpc-url ${ANVIL_RPC_URL:-http://127.0.0.1:8545} --broadcast --private-key $PRIVATE_KEY --via-ir -vv",
    "deploy:unichain-sepolia": "forge script script/Deploy.s.sol:DeployScript --rpc-url $UNICHAIN_SEPOLIA_RPC_URL --broadcast --private-key $PRIVATE_KEY --via-ir -vv",
    "demo:anvil": "forge script script/Demo.s.sol:DemoScript --rpc-url ${ANVIL_RPC_URL:-http://127.0.0.1:8545} --broadcast --private-key $PRIVATE_KEY --via-ir -vv"
  }
}
